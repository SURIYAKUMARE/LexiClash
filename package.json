{
  "name": "skillpath-ai",
  "version": "1.0.0",
  "private": true,
  "description": "SkillPath AI - Your Skills. Your Career. Your Personalized Journey.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "tsc -p tsconfig.server.json && tsx --test tests/actionMap.test.ts tests/security.test.ts tests/codingAssessment.test.ts tests/multiAgent.test.ts tests/offlineSync.test.ts tests/careerSimulator.test.ts tests/api.test.js",
    "test:coverage": "tsc -p tsconfig.server.json && tsx --test tests/actionMap.test.ts tests/security.test.ts tests/codingAssessment.test.ts tests/multiAgent.test.ts tests/offlineSync.test.ts tests/careerSimulator.test.ts tests/api.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "uuid": "^11.0.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
